<!DOCTYPE html>
<html lang="en">
<head>
  <title>ODrive - Settings</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="logo.png" id="favicon">
  <script src="/javascript/jquery.min.js"></script>
  <link rel="stylesheet" type="text/css" href="/stylesheets/styles.css">
</head>
<body class="settings">
  <div class="container">
    <!-- Account Info -->
    <section class="mb-4">
      <h4>Account</h4>
      <div class="card">
        <div class="card-body">
          <p>Logged in as: <strong><%= email %></strong></p>
          <p>Synced files: <strong id="syncedCount"><%= syncedFilesCount %></strong></p>
          <a href="/logout" class="btn btn-sm btn-danger">Logout</a>
        </div>
      </div>
    </section>

    <!-- Folder Selection -->
    <section class="mb-4">
      <h4>Folder Location</h4>
      <p>Select the folder to sync with EngazeWell</p>
      
      <div class="input-group">
        <input type="text" class="form-control" id="folderPath" 
               value="<%= folder %>" readonly>
        <div class="input-group-append">
          <button class="btn btn-outline-secondary" type="button" 
                  onclick="selectFolder()" id="selectFolderBtn">
            Select Folder
          </button>
        </div>
      </div>
      <small class="form-text text-muted">
        Files in this folder will be uploaded to EngazeWell
      </small>
    </section>

    <!-- Sync Status -->
    <section class="mb-4">
      <h4>Sync Status</h4>
      <div id="syncStatus" class="alert alert-info">
        <div id="statusText">Ready to sync</div>
        <div id="progressBar" class="progress mt-2" style="display: none;">
          <div class="progress-bar" role="progressbar" style="width: 0%"></div>
        </div>
        <div id="progressText" class="mt-1 small"></div>
      </div>
    </section>

    <!-- Sync Button -->
    <section>
      <div class="text-right">
        <button class="btn btn-primary btn-lg" id="syncButton" 
                onclick="startSync()" <%= !hasFolder ? 'disabled' : '' %>>
          <span id="syncIcon">🔄</span>
          <span id="syncText">Start Sync</span>
        </button>
      </div>
    </section>

    <!-- Sync Log -->
    <section class="mt-4">
      <h5>Sync Log</h5>
      <div id="syncLog" class="card">
        <div class="card-body" style="max-height: 200px; overflow-y: auto;">
          <div id="logMessages"></div>
        </div>
      </div>
    </section>
  </div>

  <script>
    let isSyncing = false;
    const { ipcRenderer } = require('electron');
    const { dialog } = require('electron').remote;
    
    function addLog(message, type = 'info') {
      const logDiv = document.getElementById('logMessages');
      const messageDiv = document.createElement('div');
      messageDiv.className = `log-${type}`;
      messageDiv.innerHTML = `[${new Date().toLocaleTimeString()}] ${message}`;
      logDiv.appendChild(messageDiv);
      logDiv.scrollTop = logDiv.scrollHeight;
    }
    
    function selectFolder() {
      dialog.showOpenDialog({
        properties: ['openDirectory']
      }).then(result => {
        if (!result.canceled && result.filePaths.length > 0) {
          const folder = result.filePaths[0];
          document.getElementById('folderPath').value = folder;
          
          fetch('/select-folder', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ folder })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              addLog(`Folder selected: ${folder}`, 'success');
              document.getElementById('syncButton').disabled = false;
              setTimeout(checkSyncStatus, 1000);
            } else {
              addLog(`Error: ${data.error}`, 'error');
            }
          })
          .catch(error => {
            addLog(`Error: ${error.message}`, 'error');
          });
        }
      }).catch(error => {
        addLog(`Error selecting folder: ${error.message}`, 'error');
      });
    }
    
    function startSync() {
      if (isSyncing) return;
      
      isSyncing = true;
      document.getElementById('syncButton').disabled = true;
      document.getElementById('syncIcon').textContent = '⏳';
      document.getElementById('syncText').textContent = 'Syncing...';
      document.getElementById('progressBar').style.display = 'block';
      document.getElementById('progressText').textContent = 'Starting...';
      document.getElementById('statusText').textContent = 'Syncing...';
      
      addLog('Starting synchronization...', 'info');
      
      fetch('/start-sync', { method: 'POST' })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            addLog('Sync started successfully', 'success');
          } else {
            addLog(`Error: ${data.error}`, 'error');
            resetSyncButton();
          }
        })
        .catch(error => {
          addLog(`Error: ${error.message}`, 'error');
          resetSyncButton();
        });
    }
    
    function resetSyncButton() {
      isSyncing = false;
      document.getElementById('syncButton').disabled = false;
      document.getElementById('syncIcon').textContent = '🔄';
      document.getElementById('syncText').textContent = 'Start Sync';
      document.getElementById('progressBar').style.display = 'none';
      document.getElementById('statusText').textContent = 'Ready to sync';
    }
    
    function updateProgress(progress) {
      if (progress && progress.totalFiles > 0) {
        const percent = Math.round((progress.processedFiles / progress.totalFiles) * 100);
        document.querySelector('.progress-bar').style.width = `${percent}%`;
        
        if (progress.status === 'auto-syncing') {
          document.getElementById('progressText').textContent = 
            `Auto-sync: ${progress.processedFiles}/${progress.totalFiles} files`;
          document.getElementById('statusText').textContent = 'Auto-syncing new files...';
        } else {
          document.getElementById('progressText').textContent = 
            `${progress.processedFiles}/${progress.totalFiles} files - ${progress.currentFile || 'Processing...'}`;
          document.getElementById('statusText').textContent = progress.currentFile ? 
            `Syncing: ${progress.currentFile}` : 'Syncing...';
        }
      }
    }
    
    ipcRenderer.on('sync-progress', (event, progress) => {
      updateProgress(progress);
      if (progress.currentFile) {
        addLog(`Uploading: ${progress.currentFile} (${progress.processedFiles}/${progress.totalFiles})`, 'info');
      }
    });
    
    ipcRenderer.on('sync-complete', (event, result) => {
      addLog(`Sync completed! ${result.summary}`, 'success');
      document.getElementById('statusText').textContent = 'Sync completed';
      resetSyncButton();
      updateSyncedCount();
    });
    
    ipcRenderer.on('sync-error', (event, error) => {
      addLog(`Sync error: ${error}`, 'error');
      document.getElementById('statusText').textContent = 'Sync failed';
      resetSyncButton();
    });
    
    ipcRenderer.on('auto-sync-complete', (event, result) => {
      addLog(`Auto-sync completed: ${result.uploadedCount} files uploaded`, 'success');
      updateSyncedCount();
    });
    
    function updateSyncedCount() {
      fetch('/sync-status')
        .then(response => response.json())
        .then(data => {
          if (data.syncedFilesCount !== undefined) {
            document.getElementById('syncedCount').textContent = data.syncedFilesCount;
          }
        });
    }
    
    function checkSyncStatus() {
      fetch('/sync-status')
        .then(response => response.json())
        .then(data => {
          if (data.syncing) {
            isSyncing = true;
            document.getElementById('syncButton').disabled = true;
            document.getElementById('syncIcon').textContent = '⏳';
            document.getElementById('syncText').textContent = 'Syncing...';
            
            if (data.progress) {
              updateProgress(data.progress);
              document.getElementById('progressBar').style.display = 'block';
            }
          } else if (isSyncing) {
            resetSyncButton();
          }
          
          if (data.syncedFilesCount !== undefined) {
            document.getElementById('syncedCount').textContent = data.syncedFilesCount;
          }
        })
        .catch(error => {
          console.error('Status check error:', error);
        });
    }
    
    checkSyncStatus();
    
    setInterval(checkSyncStatus, 3000);
    
    setInterval(() => {
      fetch('/sync-status')
        .then(response => response.json())
        .then(data => {
          if (!data.syncing && data.hasFolder) {
            fetch('/check-new-files', { method: 'POST' })
              .catch(error => console.error('Auto-check error:', error));
          }
        });
    }, 5000);
  </script>
</body>
</html>