{
  "name": "engazewell-resume-uploader",
  "version": "0.3.0",
  "description": "EngazeWell Resume Uploader and auto syncer.",
  "main": "main.js",
  "repository": "https://github.com/lakshmanvadikala/local-upload.git",

  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "array-unique": "^0.3.2",
    "auto-launch": "^5.0.5",
    "body-parser": "^1.20.2",
    "bootstrap": "5.3.8",
    "chokidar": "^3.5.3",
    "command-line-args": "^5.1.1",
    "deep-equal": "^2.0.1",
    "delay": "^5.0.0",
    "ejs": "^3.0.1",
    "express": "^4.18.2",
    "file-loader": "^5.0.2",
    "font-awesome": "^4.7.0",
    "form-data": "^4.0.5",
    "fs-extra": "^10.1.0",
    "googleapis": "^105.0.0",
    "jquery": "^3.4.1",
    "md5-file": "^5.0.0",
    "mkdirp-promise": "^5.0.1",
    "morgan": "^1.9.1",
    "nedb-promise": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-notifier": "^10.0.1",
    "popper.js": "^1.16.0",
    "sass": "^1.70.0",
    "sass-loader": "^10.5.2",
    "tether": "^1.4.7"
  },

  "devDependencies": {
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "^3.4.1",
    "electron": "^8.0.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^14.1.1",
    "eslint": "^6.8.0",
    "mini-css-extract-plugin": "^1.6.2",
    "resolve-url-loader": "^5.0.0",
    "style-loader": "^2.0.0",
    "url-loader": "^3.0.0",
    "webpack": "^4.41.5",
    "webpack-cli": "^3.3.10"
  },

  "scripts": {
    "lint": "eslint app main.js",
    "test": "npm run lint",
    "start": "electron main",
    "webpack": "webpack",
    "postinstall": "npm run webpack && electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release-linux": "electron-builder --linux",
    "release-windows": "electron-builder --windows",
    "release-mac": "electron-builder --mac"
  },

  "build": {
    "appId": "com.electron.engazewell-resume-uploader",
    "productName": "EngazeWell Resume Uploader",

    "directories": {
      "output": "dist"
    },

    "files": [
      "main.js",
      "app/**/*",
      "core/**/*",
      "config/**/*",
      "public/**/*",
      "views/**/*",
      "assets/**/*",
      "package.json"
    ],

    "extraResources": [
      "app/backend/**/*",
      "public/**/*"
    ],

    "asarUnpack": [
      "node_modules/nedb*/**",
      "node_modules/chokidar/**",
      "node_modules/googleapis/**",
      "node_modules/node-fetch/**",
      "node_modules/md5-file/**",
      "node_modules/fs-extra/**",
      "node_modules/tether/**",
      "node_modules/array-unique/**",
      "node_modules/delay/**"
    ],

    "linux": {
      "category": "Archiving",
      "target": [
        "AppImage",
        "snap"
      ]
    },

    "snap": {
      "grade": "stable",
      "confinement": "classic",
      "summary": "This is a Linux GUI client for EngazeWell Resume Uploader."
    },

    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "EngazeWell Resume Uploader",
      "perMachine": false
    },

    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
